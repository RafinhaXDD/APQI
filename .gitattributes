# Normalize line endings to LF in the repo; check out with native endings unless overridden below.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Shell scripts must stay LF (run inside Linux containers)
*.sh   text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.pfx  binary
