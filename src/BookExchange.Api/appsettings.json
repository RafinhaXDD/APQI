{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  }
}
