{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Jwt": {
    "Issuer": "aqpi-api",
    "Audience": "aqpi-web",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00"
  },
  "Email": {
    "FromAddress": "no-reply@aqpi.local",
    "FromName": "AQPI"
  },
  "Storage": {
    "Provider": "LocalDisk",
    "LocalRootPath": ".data/uploads",
    "BlobContainer": "listing-images"
  },
  "OpenLibrary": {
    "BaseUrl": "https://openlibrary.org/"
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindow": "00:01:00",
    "RefreshPermitLimit": 60,
    "RefreshWindow": "00:01:00"
  }
}
