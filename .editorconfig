root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,tsx,js,jsx,css,html,md}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

# EF Core migrations are generated; don't hold them to hand-written code rules.
[**/Migrations/*.cs]
generated_code = true
