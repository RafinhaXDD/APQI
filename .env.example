# Copy to .env to override the dev defaults used by docker-compose.yml.
# These are local, throwaway credentials. Never put real secrets in this file.

# PostgreSQL + PostGIS
POSTGRES_DB=bookexchange
POSTGRES_USER=bookexchange
POSTGRES_PASSWORD=bookexchange_dev

# Host ports
DB_PORT=5432
API_PORT=5080
FRONTEND_PORT=5173
AZURITE_BLOB_PORT=10000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# API (dev-only default; production must set a real 32+ byte secret)
JWT_SIGNING_KEY=dev-only-signing-key-not-a-secret-0123456789
